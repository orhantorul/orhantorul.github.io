	id = {Aktu{\u g}2021},
	isbn = {1435-8921},
	journal = {Empirical Economics},
	number = {5},
	pages = {2557--2587},
	title = {Heterogeneity in labor income profiles: evidence from Turkey},
	ty = {JOUR},
	url = {https://doi.org/10.1007/s00181-020-01848-w},
