@article{ELGIN2021101685,
title = {Risky choices in a natural experiment from Turkey: Var Mısın Yok Musun?},
journal = {Journal of Behavioral and Experimental Economics},
volume = {92},
pages = {101685},
year = {2021},
issn = {2214-8043},
doi = {https://doi.org/10.1016/j.socec.2021.101685},
url = {https://www.sciencedirect.com/science/article/pii/S2214804321000252},
author = {Ceyhun Elgin and Orhan Torul and Ertunç Aydoğdu},
keywords = {Risk aversion, Expected utility theory, Cumulative prospect theory, Path dependence},
abstract = {In this paper, we study high-stakes risky choices of contestants in the Turkish edition of the popular TV game show Deal or No Deal. We conduct a large-scale replication of Post, Van den Assem, Baltussen, and Thaler (2008), and we investigate contestant behavior in Turkey in detail via the expected utility and cumulative prospect theory. We find strong empirical support on the role of path dependence in shaping risk attitudes: Turkish contestants who enjoy early gains or suffer early losses in the initial rounds of the game are more risk-lover than other contestants, which aligns well with the break-even and house-money effects à la Thaler and Johnson (1990). We also document that the cumulative prospect theory predicts contestant behavior better than the expected utility theory empirically. Finally, we demonstrate that risk aversion exhibits sizable heterogeneity over demographics, and female and university-graduate contestants are more risk-averse than their male and less-educated counterparts.}
}